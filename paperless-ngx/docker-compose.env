# See https://docs.paperless-ngx.com/configuration/ for all available options.

# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=change-me

PAPERLESS_TIME_ZONE=Europe/Berlin

# Default language for OCR. German primary, English fallback.
PAPERLESS_OCR_LANGUAGE=deu+eng

# Initial admin account (only used on first start)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me

USERMAP_UID=1000
USERMAP_GID=1000
